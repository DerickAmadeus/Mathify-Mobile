{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "web-build"
      }
    },
    {
      "src": "backend/src/index.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 10
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/src/index.js"
    },
    {
      "src": "/api-docs",
      "dest": "backend/src/index.js"
    },
    {
      "src": "/api-docs/(.*)",
      "dest": "backend/src/index.js"
    },
    {
      "src": "/swagger.json",
      "dest": "backend/src/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "web-build/index.html"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "functions": {
    "backend/src/index.js": {
      "maxDuration": 10
    }
  }
}